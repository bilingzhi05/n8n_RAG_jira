    {
      "parameters": {
        "language": "python",
        "pythonCode": "import re\n\nitem = items[0][\"json\"]\n\nresults = []\ndata_xml = item.get(\"data\", \"\")\n\n# 提取 manifest 中所有 project 节点\nprojects = re.findall(\n    r'<project[^>]+name=\"([^\"]+)\"[^>]+revision=\"([^\"]+)\"',\n    data_xml\n)\n\n# 转成集合方便查找\nproject_branch_set = set(\n    (name.strip(), revision.strip())\n    for name, revision in projects\n)\n\nfor entry in items[0][\"json\"].get(\"input\", []):\n    project_full = entry.get(\"project\", \"\")\n    branch = entry.get(\"branch\", \"\")\n\n    # 只保留最后两个目录\n    parts = project_full.split(\"/\")\n    short_project = \"/\".join(parts[-2:]) if len(parts) >= 2 else project_full\n\n    exists = (short_project, branch) in project_branch_set\n\n    results.append({\n        \"original_project\": project_full,\n        \"short_project\": short_project,\n        \"branch\": branch,\n        \"exists_in_data\": exists,\n        \"patch_url\": entry.get(\"patch_url\")\n    })\n\nreturn results\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
