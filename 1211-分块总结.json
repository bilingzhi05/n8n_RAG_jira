    {
      "parameters": {
        "language": "python",
        "pythonCode": "comments = items[0].get(\"json\", {}).get(\"comments_list\", [])\nmax_len = 512\n\nchunks = []\ncurrent_chunk = \"\"\n\nfor comment in comments:\n    if not comment:\n        continue\n\n    # 如果单条 comment 本身超过 512，则直接当成独立 chunk\n    if len(comment) > max_len:\n        if current_chunk:\n            chunks.append(current_chunk)\n            current_chunk = \"\"\n        chunks.append(comment)\n        continue\n\n    # 当前 chunk + 本条 comment 会不会超过 512\n    if len(current_chunk) + len(comment) > max_len:\n        # 结算当前 chunk\n        if current_chunk:\n            chunks.append(current_chunk)\n        current_chunk = comment  # 新开一段\n    else:\n        # 同一段继续添加\n        current_chunk += comment\n\n# 最后一段\nif current_chunk:\n    chunks.append(current_chunk)\n\n# 返回给 n8n\nreturn [{\"json\": {\"chunk\": c}} for c in chunks]\n"
      },
