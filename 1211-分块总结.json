      "parameters": {
        "language": "python",
        "pythonCode": "# 假设 _input.all() 中已经包含了每条 text 的 token_count\nitems = _input.all()\n# user_token_count = _input.all()[0]['json']['user_token_count']\nmax_token = _input.all()[0]['json']['max_token']\nMAX_TOKENS = int(max_token)\n\n\nchunks = []\ncurrent_chunk = []\ncurrent_chunk_token_count = 0\nuser_jira = ''\nimport json\nfor item in items:\n    comments = item['json']['comments']\n    token_count = item['json']['token_count']\n    # user_jira = item['json']['user_jira']\n    # user_jira_json = json.loads(user_jira)\n    # user_sw = user_jira_json[\"software_version\"]\n    # user_hw = user_jira_json[\"hardware_version\"]\n    # kb_jira_json = json.loads(text)\n    # kb_sw = kb_jira_json[\"software_version\"]\n    # kb_hw = kb_jira_json[\"hardware_version\"]\n  \n    if current_chunk_token_count + token_count > MAX_TOKENS:\n        if current_chunk:\n            chunks.append({\n                \"json\": {\n                    \"comments_str\": \"\\n\".join(current_chunk),\n                    \"comments\": current_chunk,\n                    \"token_count\": current_chunk_token_count,\n                    # \"user_jira\": user_jira\n                }\n            })\n        current_chunk = [comments]\n        current_chunk_token_count = token_count\n    else:\n        # if kb_hw != user_hw or kb_sw != user_sw:\n        #     continue\n        current_chunk.append(comments)\n        current_chunk_token_count += token_count\n\nif current_chunk:\n    chunks.append({\n        \"json\": {\n            \"comments_str\": \"\\n\".join(current_chunk),\n            \"comments\": current_chunk,\n            \"token_count\": current_chunk_token_count,\n            # \"user_jira\": user_jira\n        }\n    })\n\nreturn chunks\n"
      },
