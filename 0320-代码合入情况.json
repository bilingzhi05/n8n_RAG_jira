      "name": "Merge1"
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "item0 = items[0][\"json\"]\nitem1 = items[0][\"json\"]\nresult = []\nproject_branches = item0.get(\"project_branches\", [])\nif not project_branches:\n  return {\"result\": result}\n\ndata = item1.get(\"data\", \"\")\nif not data:\n  return {\"result\": result}\n\n\nfor pb in project_branches:\n    merged = pb\n    merged[\"data_xml\"] = data\n    result.append(merged)\n\nreturn {\"result\": result}\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6420,
        0
      ],
      "id": "3fe5f3ad-2bff-427f-916a-20deca90a92a",
