      "name": "output2",
      "disabled": true
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "import json\n\n# 读取 n8n 输入\nitems_input = items  # items 本身就是 n8n 输入列表\n\noutput_items = []\n\nunreleased_patches = []\nreleased_patches = []\nfor item in items_input:\n    data = item.get(\"json\", {})\n    \n    all_patches = data.get(\"all_urls\", [])\n    merge_patch_url = data.get(\"merge_urls\", [])\n    released_patches_list = data.get(\"released_patches\", [])\n    unreleased_patches_list = data.get(\"unreleased_patches\", [])\n    # 如果 merge_patch_url 有多个元素，用分号拼接\n    merge_patch_str = \" ; \".join(merge_patch_url) if merge_patch_url else \"\"\n    all_patches_str = \" ; \".join(all_patches) if all_patches else \"\"\n    for released_patch in released_patches_list:\n      patch_url = released_patch.get(\"patch_url\") or \"\"\n      patch_path = released_patch.get(\"patch_path\") or \"\"\n  \n      if patch_path:\n          released_patches.append(\"{} ( {} )\".format(patch_url, patch_path))\n      else:\n          released_patches.append(\"{}\".format(patch_url))\n\n\n    for unreleased_patch in unreleased_patches_list:\n        patch_url = unreleased_patch.get(\"patch_url\") or \"\"\n        patch_path = unreleased_patch.get(\"patch_path\") or \"\"\n    \n        if patch_path:\n            unreleased_patches.append(\"{} ( {} )\".format(patch_url, patch_path))\n        else:\n            unreleased_patches.append(\"{}\".format(patch_url))\n    \n    \n    released_patches_str = \" ; \".join(released_patches) if released_patches else \"\"\n    unreleased_patches_str = \" ; \".join(unreleased_patches) if unreleased_patches else \"\"\n\n    # 输出 JSON 序列化的形式\n    output_items.append({\n        \"json\": {\n            \"all_patches\": all_patches,\n            \"all_patches_str\" : all_patches_str,\n            \"merge_patch_url\": merge_patch_str,\n            \"unreleased_patches\": unreleased_patches_str,\n            \"released_patches\": released_patches_str\n        }\n    })\n\n# 返回给 n8n\nreturn output_items\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        -260
      ],
