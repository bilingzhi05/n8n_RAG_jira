              "value": "=**{{ $('入口').item.json.similar_jira_id }}**所有的patch:{{ $json.all_patches_str }} <br> 是强制patch url:{{ $json.released_patches }} <br> 不是强制patch url:{{ $json.unreleased_patches }} <br> **{{ $('入口').item.json.user_jira_id }}**已经合入的patch:{{ $json.merge_patch_url }}",
              "type": "string"
            }
