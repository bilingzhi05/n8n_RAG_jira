        "language": "python",
        "pythonCode": "import json\n\n# 读取 n8n 输入\nitems_input = items  # items 本身就是 n8n 输入列表\n\noutput_items = []\n\nfor item in items_input:\n    data = item.get(\"json\", {})\n    \n    all_patches = data.get(\"all_patches\", [])\n    merge_patch_url = data.get(\"merge_patch_url\", [])\n\n    # 如果 merge_patch_url 有多个元素，用分号拼接\n    merge_patch_str = \" ; \".join(merge_patch_url) if merge_patch_url else \"\"\n\n    # 输出 JSON 序列化的形式\n    output_items.append({\n        \"json\": {\n            \"all_patches\": all_patches,\n            \"all_patches_str\" : all_patches[0],\n            \"merge_patch_url\": merge_patch_str\n        }\n    })\n\n# 返回给 n8n\nreturn output_items\n"
