    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "import re\n\n# n8n 输入\nitem = items[0][\"json\"]\ncomments = item.get(\"comments\", [])\n\nresult = []\n\n# http / https URL 正则\nurl_pattern = re.compile(r'https?://[^\\s\\]\\)]+')\n# 提取 URL 末尾数字（change id）\nchange_id_pattern = re.compile(r'/(\\d+)$')\nall_urls = []\nseen = set()\nfor comment in comments:\n    if not isinstance(comment, str):\n        continue\n\n    # 只处理包含 Change proposed 的 comment\n    # if \"Change proposed\" not in comment:\n    #     continue\n\n    urls = url_pattern.findall(comment)\n    \n    for url in urls:\n        match = change_id_pattern.search(url)\n        if not match:\n            continue\n        if url not in seen:\n          all_urls.append(url)\n          seen.add(url)\n        result.append({\n            \"url\": url,\n            \"change_id\": match.group(1)\n        })\n    \nreturn [\n    {\n        \"all_patches\": {\n            \"change_proposed_change_ids\": result,\n            \"all_patches\": \"\\n\".join(all_urls)\n        }\n    }\n]\n"
      },
