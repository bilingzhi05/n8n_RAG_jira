      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nproject_branches = []\nfor item in _input.all():\n  project_full = item.json.project\n  parts = project_full.split(\"/\")\n  short_project = \"/\".join(parts[-2:]) if len(parts) >= 2 else project_full\n  project_branches.append({'project': short_project,\n                         'branch': item.json.branch,\n                         'patch_url': item.json.patch_url})\nreturn {'project_branches': project_branches}"
