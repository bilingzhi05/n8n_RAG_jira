      "id": "67959629-f561-433e-b111-6af918d3eeb5",
      "name": "接受RAG返回内容",
      "disabled": true
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "import re\nimport json\n\n# 输入\nraw_text = _input.all()[0][\"json\"].get(\"RAG返回内容\", \"\")\n\nresult = {\n    \"summary\": \"\",\n    \"similar_jira_ids\": [],\n    \"similar_answers\": {}\n}\n\n# ---------- 1. 提取总结（去掉“相似的jira_id有：”之后的部分） ----------\nsummary_match = re.split(r\"相似的jira_id有：\", raw_text)\nif summary_match:\n    result[\"summary\"] = summary_match[0].strip()\n\n# ---------- 2. 提取相似的 jira id ----------\njira_match = re.search(r\"相似的jira_id有：([A-Za-z0-9\\-_, ]+)\", raw_text)\nif jira_match:\n    raw_ids = jira_match.group(1).strip()\n    # 支持多个 id（用逗号、空格分隔）\n    ids = re.split(r\"[,\\s]+\", raw_ids)\n    result[\"similar_jira_ids\"] = [i for i in ids if i]\n\n# ---------- 3. 提取相似的 answer JSON ----------\nanswer_match = re.search(r\"相似的answer有：(\\{[\\s\\S]*?\\})\", raw_text)\nif answer_match:\n    ans_text = answer_match.group(1).strip()\n\n    # 尝试解析 JSON\n    try:\n        result[\"similar_answers\"] = json.loads(ans_text)\n    except:\n        # 如果格式不标准，进行清洗后再解析\n        try:\n            cleaned = ans_text.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n            result[\"similar_answers\"] = json.loads(cleaned)\n        except:\n            result[\"similar_answers\"] = {\"raw_text\": ans_text}\n\n# ---------- 输出 ----------\nreturn [{\n    \"json\": result\n}]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
