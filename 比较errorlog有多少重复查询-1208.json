    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "57f62e60-7688-4614-b3a5-e6777d73047d",
              "name": "RAG返回内容",
              "value": "={{ $json.choices[0].message.content }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
